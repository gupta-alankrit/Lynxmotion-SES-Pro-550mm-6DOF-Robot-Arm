<launch>
  <!-- Arm + MoveIt -->
  <arg name="dof" default="6"/>
  <arg name="size" default="550"/>

  <!-- RealSense camera + classifier overrides commonly set on the command line -->
  <arg name="camera_name" default="camera"/>
  <arg name="camera_namespace" default="camera"/>
  <arg name="depth_profile" default="640x480x30"/>
  <arg name="rgb_profile" default="640x480x30"/>
  <arg name="show_window" default="true"/>
  <arg name="yolo_device" default="cpu"/>
  <arg name="stage2_device" default="cuda"/>

  <!-- Drop point in the arm base frame -->
  <arg name="drop_x" default="0.0"/>
  <arg name="drop_y" default="-0.4"/>
  <arg name="drop_z" default="0.1"/>
  <arg name="drop_roll" default="0.0"/>
  <arg name="drop_pitch" default="0.0"/>
  <arg name="drop_yaw" default="0.0"/>

  <!-- Approach pose above each detected target -->
  <arg name="target_offset_z" default="0.1"/>
  <arg name="target_roll" default="0.0"/>
  <arg name="target_pitch" default="0.0"/>
  <arg name="target_yaw" default="0.0"/>

  <!-- Dwell + detection timing -->
  <arg name="wait_at_target_sec" default="5.0"/>
  <arg name="wait_at_drop_sec" default="5.0"/>
  <arg name="settle_sec" default="2.0"/>
  <arg name="detection_timeout_sec" default="10.0"/>

  <!-- Motion + ROS common -->
  <arg name="velocity_scaling" default="0.3"/>
  <arg name="acceleration_scaling" default="0.3"/>
  <arg name="planning_time" default="10.0"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="log_level" default="warn"/>

  <!-- Real pro_arm with MoveIt 2 -->
  <include file="$(find-pkg-share pro_arm_moveit)/launch/real_arm_control.launch.py">
    <arg name="dof" value="$(var dof)"/>
    <arg name="size" value="$(var size)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="log_level" value="$(var log_level)"/>
  </include>

  <!-- RealSense camera + two_stage_live_classifier + reprojection_3D -->
  <include file="$(find-pkg-share machine_vision_pkg)/launch/objects_in_3D.launch.xml">
    <arg name="camera_name" value="$(var camera_name)"/>
    <arg name="camera_namespace" value="$(var camera_namespace)"/>
    <arg name="depth_profile" value="$(var depth_profile)"/>
    <arg name="rgb_profile" value="$(var rgb_profile)"/>
    <arg name="show_window" value="$(var show_window)"/>
    <arg name="yolo_device" value="$(var yolo_device)"/>
    <arg name="stage2_device" value="$(var stage2_device)"/>
  </include>

  <!-- Vision-driven loop: home -> enable classifier -> grab targets -> disable
       -> move above first target -> wait -> move to drop point -> wait -> loop.
       The node's own wait_for_servers() blocks until /compute_ik, /move_action,
       and /two_stage_live_classifier/set_active are all up, so no explicit
       startup delay is needed here. -->
  <node pkg="machine_vision_pkg" exec="classify_pick_and_place" name="classify_pick_and_place" output="screen">
    <param name="drop_x" value="$(var drop_x)"/>
    <param name="drop_y" value="$(var drop_y)"/>
    <param name="drop_z" value="$(var drop_z)"/>
    <param name="drop_roll" value="$(var drop_roll)"/>
    <param name="drop_pitch" value="$(var drop_pitch)"/>
    <param name="drop_yaw" value="$(var drop_yaw)"/>

    <param name="target_offset_z" value="$(var target_offset_z)"/>
    <param name="target_roll" value="$(var target_roll)"/>
    <param name="target_pitch" value="$(var target_pitch)"/>
    <param name="target_yaw" value="$(var target_yaw)"/>

    <param name="wait_at_target_sec" value="$(var wait_at_target_sec)"/>
    <param name="wait_at_drop_sec" value="$(var wait_at_drop_sec)"/>
    <param name="settle_sec" value="$(var settle_sec)"/>
    <param name="detection_timeout_sec" value="$(var detection_timeout_sec)"/>

    <param name="velocity_scaling" value="$(var velocity_scaling)"/>
    <param name="acceleration_scaling" value="$(var acceleration_scaling)"/>
    <param name="planning_time" value="$(var planning_time)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
